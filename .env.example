# Copy this file to .env and edit the values you actually use.

GORUNNERS_SECRET=change-this-in-production

# Option A: quick local preview with SQLite
# Leave all database settings below commented out.

# Option B: MySQL via a full connection URL
# GORUNNERS_DB="mysql+pymysql://root:password@127.0.0.1:3306/gorunners?charset=utf8mb4"

# Option C: MySQL via separate env vars
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=gorunners

# Optional overrides
# GORUNNERS_UPLOADS=server/uploads
# DIFY_BASE_URL=
# DIFY_API_KEY=
